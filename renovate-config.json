{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":semanticCommitsDisabled", ":pinVersions"],
  "commitMessagePrefix": "DEPS:",
  "baseBranchPatterns": ["main"],
  "labels": ["dependencies"],
  "dependencyDashboard": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Pumpkin plugin API versions are build targets (api262, api263) that change by hand with each Pumpkin release",
      "matchPackageNames": ["pumpkin-plugin-api"],
      "enabled": false
    }
  ]
}
